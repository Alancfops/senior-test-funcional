# Copiado automaticamente por `make setup` → backend/.env
DATABASE_URL="postgresql://senior:senior@localhost:5432/senior_test?schema=public"

# test:e2e usa banco isolado senior_test_e2e (npm run test:e2e:prepare) — NUNCA apaga senior_test

# Segredos JWT — valores abaixo funcionam em dev local; troque antes de homologação/produção
JWT_ACCESS_SECRET=dev-change-me-access-secret-min-32-chars!!
JWT_ACCESS_EXPIRES_IN=7d

PORT=3000
NODE_ENV=development

# Gerenciador web (CORS em produção) — ver stf-gerenciador-web
# CORS_ORIGINS=http://localhost:5173,https://admin.seudominio.exemplo

# Seed admin (dev) — npm run prisma db seed
# ADMIN_SEED_EMAIL=admin@clinica.exemplo
# ADMIN_SEED_PASSWORD=Admin1234
# ADMIN_SEED_FULL_NAME=Coordenador Clínico

# ── E-mail RF003 (Gmail do projeto — TCC, sem domínio) ─────────────────────
# Decisão: sem compra de domínio — ver docs/engineering/project-decisions.md
# Crie um Gmail SÓ do app (ex.: no.replystf@gmail.com ou seniortestefuncional@gmail.com).
# Gmail gratuito não permite no.reply@ — use o nome antes do @gmail.com.
# 1. Conta nova → ative verificação em 2 etapas
# 2. Senha de app: https://myaccount.google.com/apppasswords
# 3. Cole abaixo (16 caracteres, sem espaços)
MAIL_PROVIDER=gmail
GMAIL_USER=seniortestfuncional@gmail.com
GMAIL_APP_PASSWORD=cole_sua_senha_de_app_aqui
MAIL_FROM="Senior Teste Funcional <seniortestfuncional@gmail.com>"

# resend (requer domínio verificado): MAIL_PROVIDER=resend + RESEND_API_KEY
# offline / CI: MAIL_PROVIDER=console
