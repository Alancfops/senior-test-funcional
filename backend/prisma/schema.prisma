generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AssessmentStatus {
  DRAFT
  FINALIZED
}

enum TherapistRole {
  THERAPIST
  ASSISTANT
  ADMIN
}

enum AdminAuditAction {
  DELETE_PATIENT
  TRANSFER_PATIENT
  DELETE_THERAPIST
  DOWNLOAD_REPORT
  CREATE_THERAPIST
}

enum AdminAccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Therapist {
  id                 String        @id @default(uuid()) @db.Uuid
  email              String
  fullName           String        @map("full_name")
  passwordHash       String        @map("password_hash")
  role               TherapistRole @default(THERAPIST)
  mustChangePassword Boolean       @default(false) @map("must_change_password")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  passwordResetTokens PasswordResetToken[]
  patients            Patient[]
  assessments         Assessment[]
  adminAuditLogs      AdminAuditLog[]
  resolvedAccessRequests AdminAccessRequest[] @relation("AccessRequestResolver")

  /// Permite o mesmo e-mail como THERAPIST (mobile) e ADMIN (gerenciador), contas distintas.
  @@unique([email, role])
  @@index([email])
  @@map("therapists")
}

model AdminAccessRequest {
  id           String                   @id @default(uuid()) @db.Uuid
  email        String
  fullName     String                   @map("full_name")
  status       AdminAccessRequestStatus @default(PENDING)
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt   DateTime?                @map("resolved_at") @db.Timestamptz(6)
  resolvedById String?                  @map("resolved_by_id") @db.Uuid

  resolvedBy Therapist? @relation("AccessRequestResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([email])
  @@map("admin_access_requests")
}

model AdminAuditLog {
  id         String           @id @default(uuid()) @db.Uuid
  adminId    String           @map("admin_id") @db.Uuid
  action     AdminAuditAction
  targetType String           @map("target_type")
  targetId   String           @map("target_id") @db.Uuid
  metadata   Json             @default("{}")
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  admin Therapist @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId])
  @@index([targetType, targetId])
  @@index([createdAt(sort: Desc)])
  @@map("admin_audit_logs")
}

model Patient {
  id            String   @id @default(uuid()) @db.Uuid
  therapistId   String   @map("therapist_id") @db.Uuid
  fullName      String   @map("full_name")
  age           Int      @db.SmallInt
  gender        String
  contact       String
  schoolingBand String?  @map("schooling_band")
  avatarUrl     String?  @map("avatar_url")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  therapist   Therapist    @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  assessments Assessment[]

  @@index([therapistId])
  @@index([therapistId, fullName])
  @@map("patients")
}

model PasswordResetToken {
  id          String   @id @default(uuid()) @db.Uuid
  therapistId String   @map("therapist_id") @db.Uuid
  tokenHash   String   @unique @map("token_hash")
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)
  consumed    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  therapist Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)

  @@index([therapistId])
  @@map("password_reset_tokens")
}

model Instrument {
  code        String @id
  displayName String @map("display_name")
  authorsJson String @map("authors_json")
  sortHint    Int    @map("sort_hint")

  assessments Assessment[]

  @@map("instruments")
}

model Assessment {
  id                String           @id @default(uuid()) @db.Uuid
  therapistId       String           @map("therapist_id") @db.Uuid
  patientId         String           @map("patient_id") @db.Uuid
  instrumentCode    String           @map("instrument_code")
  status            AssessmentStatus @default(DRAFT)
  startedAt         DateTime         @default(now()) @map("started_at") @db.Timestamptz(6)
  finalizedAt       DateTime?        @map("finalized_at") @db.Timestamptz(6)
  payload           Json             @default("{}")
  schoolingBandUsed String?          @map("schooling_band_used")
  notesObservation  String?          @map("notes_observation")

  therapist Therapist         @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  patient   Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  instrument Instrument       @relation(fields: [instrumentCode], references: [code])
  result    AssessmentResult?

  @@index([therapistId, patientId, instrumentCode, finalizedAt(sort: Desc)])
  @@index([status])
  @@map("assessments")
}

model AssessmentResult {
  assessmentId        String   @id @map("assessment_id") @db.Uuid
  rawValue            Decimal  @map("raw_value") @db.Decimal(10, 2)
  rawLabel            String   @map("raw_label")
  classificationLabel String   @map("classification_label")
  classificationCode  String   @map("classification_code")
  classificationMeta  Json     @map("classification_meta")
  computedAt          DateTime @default(now()) @map("computed_at") @db.Timestamptz(6)

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("assessment_results")
}
