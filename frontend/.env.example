# URL base da API NestJS (sem barra final)
# iOS simulador: http://localhost:3000
# Android emulador: localhost funciona (o app troca para 10.0.2.2 automaticamente)
# Celular físico: `make start` sobrescreve com o IP LAN detectado (hostname -I).
# Emulador / web: pode deixar localhost — ou rode só `cd frontend && npm run start`.
EXPO_PUBLIC_API_URL=http://localhost:3000

# false = usa API real (backend em make start)
EXPO_PUBLIC_MOCK_AUTH=false
